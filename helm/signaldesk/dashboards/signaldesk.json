{
  "uid": "signaldesk-incidents",
  "title": "SignalDesk incident API",
  "description": "Live metrics scraped from the backend /metrics endpoint.",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["signaldesk", "incidents"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate by route",
      "description": "Requests per second across the backend replicas; refresh the app to generate traffic.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(incident_http_requests_total{route=~\"/api/.*\"}[5m]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Incidents created",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(incident_created_total)", "legendFormat": "Created" }
      ],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API p95 latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(incident_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    }
  ]
}
